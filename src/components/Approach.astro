---
import { APPROACH } from "../data/page";
---
<section id="approach" class="approach">
  <div class="wrap approach-grid">
    <div class="approach-lead">
      <p class="eyebrow">{APPROACH.eyebrow}</p>
      <h2 class="h2" set:html={APPROACH.heading} />
      {APPROACH.body.map((p) => <p set:html={p} />)}
    </div>
    <ol class="pillars">
      {APPROACH.pillars.map((p, i) => (
        <li class="pillar">
          <span class="pillar-n">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3 set:html={p.title} />
            <p set:html={p.body} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
