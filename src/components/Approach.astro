---
import { APPROACH } from "../data/page";
---
<!-- The approach statement gets its own deep teal band: the one dark moment mid-page. -->
<section class="statement-band">
  <div class="wrap">
    <span class="statement-mark" aria-hidden="true">“</span>
    <p class="statement" set:html={APPROACH.intro} />
  </div>
</section>

<section id="approach" class="approach">
  <div class="wrap">
    <div class="center">
      <h2 class="h2" set:html={APPROACH.heading} />
      <div class="approach-body">
        {APPROACH.body.map((p) => <p set:html={p} />)}
      </div>
    </div>
    <ol class="pillars">
      {APPROACH.pillars.map((p, i) => (
        <li class="pillar">
          <span class="pillar-n">{i + 1}</span>
          <h3 set:html={p.title} />
          <p set:html={p.body} />
        </li>
      ))}
    </ol>
  </div>
</section>
