---
// A button that opens the audit request form in the slide-out panel (AuditForm.astro).
// Without JavaScript it falls back to opening the form in a new tab. Until the form link is set it points to "#".
import { formUrl, formEmbedUrl } from "../lib";

interface Props {
  label: string;
  variant?: "p" | "s" | "t"; // primary, secondary, or a text link with an arrow
  service?: string;
}
const { label, variant = "p", service } = Astro.props;
const url = formUrl(service);
const cls = variant === "t" ? ["text-cta"] : ["btn", `btn-${variant}`];
---
{url
  ? <a class:list={cls} href={url} target="_blank" rel="noopener" data-audit-form={formEmbedUrl(service)}>{label}</a>
  : <a class:list={cls} href="#" title="Add the Airtable form link in src/data/page.ts">{label}</a>}
