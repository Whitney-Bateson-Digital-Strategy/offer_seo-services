---
import { VIDEO } from "../data/page";
import { asset } from "../lib";
import Cta from "./Cta.astro";
---
<section id="video" class="audit-video">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">{VIDEO.eyebrow}</p>
      <h2 class="h2" set:html={VIDEO.heading} />
      <p class="lede" set:html={VIDEO.body} />
    </div>
    <div class="video-frame">
      {VIDEO.embed ? (
        <iframe src={VIDEO.embed} title={VIDEO.title} loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
      ) : VIDEO.file ? (
        <video controls preload="metadata" playsinline poster={VIDEO.poster ? asset(VIDEO.poster) : undefined}>
          <source src={asset(VIDEO.file)} type="video/mp4" />
        </video>
      ) : (
        <div class="video-placeholder">
          <span class="play" aria-hidden="true"></span>
          <p>Audit walkthrough video coming soon</p>
        </div>
      )}
    </div>
    <div class="center video-cta"><Cta label={VIDEO.cta} /></div>
  </div>
</section>
