---
import { STEPS } from "../data/page";
import Cta from "./Cta.astro";
---
<section id="begin" class="steps">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">{STEPS.eyebrow}</p>
      <h2 class="h2" set:html={STEPS.heading} />
    </div>
    <ol class="step-list">
      {STEPS.items.map((s, i) => (
        <li class="step">
          <span class="step-n">{i + 1}</span>
          <h3 set:html={s.title} />
          <p set:html={s.body} />
        </li>
      ))}
    </ol>
    <div class="center steps-cta"><Cta label={STEPS.cta} /></div>
  </div>
</section>
