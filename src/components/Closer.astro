---
import { CLOSER } from "../data/page";
import { asset } from "../lib";
import Cta from "./Cta.astro";
---
<section id="closing" class="closer" style={`background-image:url(${asset("closer-bg.jpg")})`}>
  <video class="closer-video" autoplay muted loop playsinline preload="metadata" poster={asset("closer-bg.jpg")} aria-hidden="true">
    <source src={asset("closer-bg.webm")} type="video/webm" />
    <source src={asset("closer-bg.mp4")} type="video/mp4" />
  </video>
  <div class="wrap">
    <p class="eyebrow">{CLOSER.eyebrow}</p>
    <h2 set:html={CLOSER.heading} />
    <p class="sub" set:html={CLOSER.body} />
    <Cta label={CLOSER.cta} />
  </div>
</section>
