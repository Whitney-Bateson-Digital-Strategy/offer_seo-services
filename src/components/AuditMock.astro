---
// A real free audit: the recorded walkthrough of a client's search data, with Matt narrating.
// The browser bar in the image is blurred to hide the client's name and private tabs.
import { asset } from "../lib";
---
<figure class="audit-mock">
  <img
    src={asset("audit-example.webp")}
    alt="A recorded audit video: Matt on camera walking through a Google Doc of a practice's search traffic findings, beside a printed services guide."
    width="1144" height="806" loading="lazy" decoding="async"
  />
  <figcaption>From a real audit, with client details hidden: a recorded walkthrough of your search data and the top things we’d fix first.</figcaption>
</figure>
