---
import { INCLUDED } from "../data/page";
---
<section id="included" class="included">
  <div class="wrap">
    <div class="center">
      <p class="eyebrow">{INCLUDED.eyebrow}</p>
      <h2 class="h2 h2-wide" set:html={INCLUDED.heading} />
      <p class="lede" set:html={INCLUDED.intro} />
    </div>
    <div class="inc-grid">
      {INCLUDED.items.map((x) => (
        <div class="inc">
          <h3 set:html={x.title} />
          <p set:html={x.body} />
        </div>
      ))}
    </div>
  </div>
</section>
