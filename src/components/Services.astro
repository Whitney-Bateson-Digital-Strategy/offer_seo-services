---
import { SERVICES, INCLUDED } from "../data/page";
import Cta from "./Cta.astro";
import SvcVisual from "./SvcVisual.astro";
---
<section id="services" class="services">
  <div class="wrap">
    <div class="center">
      <h2 class="h2" set:html={SERVICES.heading} />
      <p class="lede" set:html={SERVICES.intro} />
    </div>

    <div class="svc-list">
      {SERVICES.items.map((s) => (
        <article class="svc" id={s.id}>
          <div class="svc-head">
            <p class="svc-moment">{s.moment}</p>
            <h3 set:html={s.headline} />
            <SvcVisual kind={s.id} />
          </div>
          <div class="svc-intro">
            <p class="svc-meta"><strong>{s.name}</strong><span class="pill">{s.format}</span></p>
            <p class="svc-summary" set:html={s.summary} />
          </div>
          <div class="svc-body">
            <ul class="checks">{s.points.map((p) => <li set:html={p} />)}</ul>
            {s.note && <p class="svc-note" set:html={s.note} />}
          </div>
          <div class="svc-cta"><Cta label={s.cta} service={s.name} variant="t" /></div>
        </article>
      ))}
    </div>

    <div class="svc-unsure">
      <p set:html={SERVICES.unsure} />
      <Cta label={SERVICES.cta} />
    </div>

    <div class="included" id="included">
      <div class="inc-intro">
        <p class="eyebrow">{INCLUDED.eyebrow}</p>
        <h3 set:html={INCLUDED.heading} />
        <p set:html={INCLUDED.intro} />
      </div>
      {INCLUDED.items.map((x) => (
        <div class="inc">
          <h4 set:html={x.title} />
          <p set:html={x.body} />
        </div>
      ))}
    </div>
  </div>
</section>
