---
import { SERVICES, INCLUDED } from "../data/page";
import Cta from "./Cta.astro";
---
<section id="services" class="services">
  <div class="wrap">
    <div class="center">
      <h2 class="h2" set:html={SERVICES.heading} />
      <p class="lede" set:html={SERVICES.intro} />
    </div>

    <div class="svc-list">
      {SERVICES.items.map((s) => (
        <article class="svc" id={s.id}>
          <div class="svc-head">
            <p class="svc-name">{s.name}</p>
            <h3 set:html={s.headline} />
            <span class="pill">{s.format}</span>
          </div>
          <dl class="svc-facts">
            <dt>Best for</dt><dd set:html={s.bestFor} />
            <dt>What it does</dt><dd set:html={s.does} />
          </dl>
          <div class="svc-includes">
            <p class="svc-label">What’s included</p>
            <ul class="checks">{s.points.map((p) => <li set:html={p} />)}</ul>
            {s.note && <p class="svc-note" set:html={s.note} />}
          </div>
          <details class="svc-more">
            <summary>More about {s.name}</summary>
            <div class="svc-more-body">
              <p set:html={s.summary} />
              <p set:html={s.body} />
            </div>
          </details>
          <div class="svc-cta"><Cta label={s.cta} service={s.name} /></div>
        </article>
      ))}
    </div>

    <div class="included" id="included">
      <div class="inc-intro">
        <p class="eyebrow">{INCLUDED.eyebrow}</p>
        <h3 set:html={INCLUDED.heading} />
        <p set:html={INCLUDED.intro} />
      </div>
      {INCLUDED.items.map((x) => (
        <div class="inc">
          <h4 set:html={x.title} />
          <p set:html={x.body} />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Opening the details on one card opens them on all three, so they can be compared side by side.
  const toggles = [...document.querySelectorAll<HTMLDetailsElement>(".svc-more")];
  let syncing = false;
  toggles.forEach((d) =>
    d.addEventListener("toggle", () => {
      if (syncing) return;
      syncing = true;
      toggles.forEach((other) => { if (other !== d) other.open = d.open; });
      syncing = false;
    })
  );
</script>
