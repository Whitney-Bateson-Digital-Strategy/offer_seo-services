---
import { PROBLEM } from "../data/page";
import { asset } from "../lib";
---
<section id="problem" class="problem">
  <div class="wrap">
    <div class="center">
      <h2 class="h2 h2-wide" set:html={PROBLEM.heading} />
      <p class="lede" set:html={PROBLEM.intro} />
    </div>
    <ul class="pain-list">
      {PROBLEM.points.map((p) => <li set:html={p} />)}
    </ul>
    <aside class="whitney-note">
      <img src={asset(PROBLEM.note.image)} alt="" width="72" height="72" loading="lazy" />
      <div>
        {PROBLEM.note.body.map((p) => <p set:html={p} />)}
        <p class="whitney-sign">– {PROBLEM.note.signoff}</p>
      </div>
    </aside>
  </div>
</section>
